{
  "name": "ai-panel-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"npm run dev -w @aps/server\" \"npm run dev -w @aps/web\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test",
    "build": "npm run build -w @aps/web",
    "db:init": "npm run db:init -w @aps/server",
    "db:reset": "npm run db:reset -w @aps/server"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2"
  }
}

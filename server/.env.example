# 服务端监听端口
PORT=8787
# SQLite 数据库文件路径（相对 server 包根目录）
DATABASE_PATH=./data/panel.db
# 大模型提供方；留空时根据 API Key 自动选择
LLM_PROVIDER=
# 大模型 API Key；留空时使用 mock 模式
LLM_API_KEY=
# 大模型 API 基础地址
LLM_BASE_URL=https://api.deepseek.com
# 高质量模型名称
LLM_MODEL_QUALITY=deepseek-v4-pro
# 快速模型名称
LLM_MODEL_FAST=deepseek-flash
# 大模型最大并发数
LLM_MAX_CONCURRENCY=6
# 单场讨论最大轮数
MAX_TURNS=16
# 讨论节奏间隔（毫秒）
PACING_MS=800
# Mock 模式首段响应延迟（毫秒）
MOCK_LATENCY_MS=400
# Mock 模式流式响应间隔（毫秒）
MOCK_STREAM_DELAY_MS=30
